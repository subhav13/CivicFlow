# Server-only Gemini credential. Keep blank locally until an authorized audit.
GEMINI_API_KEY=

# Server-only companion access PIN for Gemini session issuance.
# Hosted voice requires it. Local Vite middleware uses it when nonblank.
# Placeholder only. Never commit, bundle, or log a real value.
CIVICFLOW_COMPANION_PIN=

# Local audit compatibility and public voice gates are disabled by default.
CIVICFLOW_LIVE_AUDIT=0
VITE_CIVICFLOW_LIVE_AUDIT=0
CIVICFLOW_VOICE_ENABLED=0
VITE_CIVICFLOW_VOICE_ENABLED=0

# Exact origins accepted by the hosted session endpoint.
CIVICFLOW_ALLOWED_ORIGINS=http://localhost:5173
CIVICFLOW_LIVE_ORIGIN=http://localhost:5173
